{
  "name": "@honeypathkar/react-native-live-update",
  "version": "0.1.0",
  "description": "Live Activities on iOS (Lock Screen + Dynamic Island) and Live Updates on Android 16 (status-bar chip, and the OEM surfaces built on it such as Samsung's Now Bar) behind one API.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "template",
    "scripts",
    "react-native.config.js",
    "*.podspec",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/.*"
  ],
  "bin": {
    "lucide-to-drawable": "./scripts/lucide-to-drawable.mjs"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "live-activity",
    "dynamic-island",
    "live-update",
    "now-bar",
    "activitykit",
    "notification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeypathkar/react-native-components.git",
    "directory": "react-native-live-update"
  },
  "homepage": "https://github.com/honeypathkar/react-native-components/tree/master/react-native-live-update#readme",
  "bugs": {
    "url": "https://github.com/honeypathkar/react-native-components/issues"
  },
  "author": "honeypathkar",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
