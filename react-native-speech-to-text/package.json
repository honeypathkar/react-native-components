{
  "name": "@honeypathkar/react-native-speech-to-text",
  "version": "1.0.2",
  "description": "Native iOS + Android speech-to-text for React Native with configurable silence detection (auto-stop on pause), real-time interim transcripts, audio level metering and full device locale support.",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/commonjs/index.js",
  "types": "lib/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android/src",
    "android/build.gradle",
    "react-native-speech-to-text.podspec",
    "README.md",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf lib",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "speech-to-text",
    "speech-recognition",
    "voice",
    "silence-detection",
    "vad",
    "sfspeechrecognizer",
    "speechrecognizer",
    "dictation",
    "transcription"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeypathkar/react-native-components.git",
    "directory": "react-native-speech-to-text"
  },
  "homepage": "https://github.com/honeypathkar/react-native-components/tree/master/react-native-speech-to-text#readme",
  "bugs": {
    "url": "https://github.com/honeypathkar/react-native-components/issues"
  },
  "author": "honeypathkar",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "typescript": "^5.0.0"
  }
}
